# ==============================================================================
# NS TECHSPHERE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_SITE_URL=https://nstechsphere.store

# Private Admin Route Path (e.g., /control-room-x7k9)
NEXT_PUBLIC_ADMIN_ROUTE=/control-room-x7k9

# Brand Settings Defaults
NEXT_PUBLIC_DEFAULT_BRAND_NAME="NS TechSphere"
NEXT_PUBLIC_DEFAULT_TAGLINE="Explore the World of Technology."
NEXT_PUBLIC_DEFAULT_CURRENCY="BDT"
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL="৳"
NEXT_PUBLIC_DEFAULT_WHATSAPP="+8801700000000"

# Supabase Credentials (PostgreSQL, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Super Admin Initial Setup Security Secret
ADMIN_SETUP_SECRET=change-this-to-a-secure-random-token-in-production

# Delivery Charges Defaults (in BDT)
NEXT_PUBLIC_SHIPPING_INSIDE_DHAKA=70
NEXT_PUBLIC_SHIPPING_OUTSIDE_DHAKA=130

# Optional Payment Gateways (Leave empty if using Cash on Delivery only)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
